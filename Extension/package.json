{
  "name": "feedtube",
  "description": "Track YouTube channel uploads and open them in your browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "node scripts/smoke-test.mjs && node scripts/io-test.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "preact": "^10.27.2",
    "spark-md5": "^3.0.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "puppeteer": "^25.9.0",
    "typescript": "^5.8.3",
    "wxt": "^0.20.11"
  }
}
